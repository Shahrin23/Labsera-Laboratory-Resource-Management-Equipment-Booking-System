<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="false" style="-fx-background: #F4F6FA; -fx-background-color: #F4F6FA;"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.labresa.controller.ForgotPasswordController">
    <StackPane style="-fx-background-color: #F4F6FA;" minHeight="600">
        <padding><Insets top="40" right="20" bottom="40" left="20"/></padding>
        <VBox alignment="CENTER" spacing="0" maxWidth="380" styleClass="auth-card">
            <VBox alignment="CENTER" spacing="6">
                <Label text="&#x1F511;" style="-fx-font-size: 36px;"/>
                <Label text="Reset your password" styleClass="auth-title"/>
                <Label fx:id="stepSubtitle" text="Step 1 of 2 - verify your email" styleClass="auth-subtitle"/>
            </VBox>

            <!-- Step 1: verify email -->
            <VBox fx:id="step1Box" spacing="12">
                <padding><Insets top="26" right="0" bottom="0" left="0"/></padding>
                <VBox spacing="4">
                    <Label text="Email" styleClass="field-label"/>
                    <TextField fx:id="emailField" promptText="you@labresa.edu"/>
                </VBox>
                <Label fx:id="step1ErrorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>
                <HBox spacing="10">
                    <Button text="Back to Login" onAction="#goBack" styleClass="btn-secondary"/>
                    <Button text="Verify Email" onAction="#handleVerifyEmail" styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Step 2: set new password -->
            <VBox fx:id="step2Box" spacing="12" managed="false" visible="false">
                <padding><Insets top="26" right="0" bottom="0" left="0"/></padding>
                <VBox spacing="4">
                    <Label text="New Password" styleClass="field-label"/>
                    <PasswordField fx:id="newPasswordField" promptText="At least 8 characters"/>
                    <Label fx:id="passwordStatusLabel" wrapText="true" managed="false" visible="false"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="Confirm New Password" styleClass="field-label"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Re-enter new password"/>
                </VBox>
                <Label fx:id="step2ErrorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false"/>
                <HBox spacing="10">
                    <Button text="Back" onAction="#backToStep1" styleClass="btn-secondary"/>
                    <Button text="Reset Password" onAction="#handleResetPassword" styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>
</ScrollPane>
